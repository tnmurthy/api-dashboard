# ─── Application ───────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# ─── Auth ───────────────────────────────────────────
JWT_SECRET=change_me_to_a_secure_random_256bit_value
JWT_EXPIRES_IN=7d

# ─── Supabase ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key_here

# ─── Blockchain ────────────────────────────────────
# Choose one RPC endpoint (local hardhat node for dev)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Production examples:
# BLOCKCHAIN_RPC_URL=https://polygon-rpc.com
# CHAIN_ID=137
# BLOCKCHAIN_RPC_URL=https://mainnet.base.org
# CHAIN_ID=8453

# Backend signer – NEVER commit the real key
BACKEND_SIGNER_PRIVATE_KEY=your_private_key_here

# ─── Deployed Contract Addresses ───────────────────
# Populated automatically by contracts/scripts/deploy.js
# or set manually after deployment.
CONTRACT_CRM_REGISTRY=
CONTRACT_CONTACT_BOOK=
CONTRACT_DEAL_PIPELINE=
CONTRACT_ACTIVITY_LEDGER=
CONTRACT_USAGE_TOKEN=
CONTRACT_INVOICE_NFT=

# ─── IPFS / Filecoin ───────────────────────────────
IPFS_API_URL=https://api.web3.storage
IPFS_API_TOKEN=your_web3_storage_token_here

# ─── Rate Limiting ─────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
